@model MfaViewModel
@{
    ViewData["Title"] = "Two-Factor Authentication";
    Layout = "_LoginLayout";
}

<div class="bg-white rounded-2xl shadow-xl p-8">
    <div class="text-center mb-6">
        <div class="inline-flex items-center justify-center w-12 h-12 bg-blue-100 rounded-full mb-3">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
            </svg>
        </div>
        <h3 class="text-2xl font-bold text-gray-900">Two-Factor Authentication</h3>
        <p class="text-sm text-gray-600 mt-2">Enter the verification code to continue</p>
    </div>

    <!-- Method tabs -->
    <div class="border-b border-gray-200 mb-6" data-tab-group>
        <nav class="flex -mb-px">
            <button type="button" data-tab="tab-authenticator" class="flex-1 py-3 px-4 text-center border-b-2 border-blue-600 text-blue-600 font-medium text-sm">
                Authenticator App
            </button>
            <button type="button" data-tab="tab-sms" class="flex-1 py-3 px-4 text-center border-b-2 border-transparent text-gray-600 font-medium text-sm">
                SMS
            </button>
            <button type="button" data-tab="tab-email" class="flex-1 py-3 px-4 text-center border-b-2 border-transparent text-gray-600 font-medium text-sm">
                Email
            </button>
        </nav>
    </div>

    <form asp-action="Mfa" method="post" data-validate class="space-y-6">
        <!-- Authenticator tab -->
        <div id="tab-authenticator" data-tab-content>
            <p class="text-sm text-gray-600 text-center mb-4">Enter the 6-digit code from your authenticator app</p>
            <div class="flex justify-center gap-2 mb-4">
                <input type="text" maxlength="1" class="w-12 h-14 text-center text-xl font-bold border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" autofocus>
                <input type="text" maxlength="1" class="w-12 h-14 text-center text-xl font-bold border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                <input type="text" maxlength="1" class="w-12 h-14 text-center text-xl font-bold border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                <span class="flex items-center text-gray-400">-</span>
                <input type="text" maxlength="1" class="w-12 h-14 text-center text-xl font-bold border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                <input type="text" maxlength="1" class="w-12 h-14 text-center text-xl font-bold border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                <input type="text" maxlength="1" class="w-12 h-14 text-center text-xl font-bold border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
            </div>
            <input type="hidden" name="Code" id="code-input">
            <input type="hidden" name="Method" value="authenticator">
        </div>

        <!-- SMS tab -->
        <div id="tab-sms" data-tab-content class="hidden">
            <p class="text-sm text-gray-600 text-center mb-2">We sent a code to</p>
            <p class="text-sm font-medium text-gray-900 text-center mb-4">+1 (***) ***-1234</p>
            <div>
                <label for="sms-code" class="block text-sm font-medium text-gray-700 mb-1">Verification Code</label>
                <input type="text" id="sms-code" name="Code" maxlength="6"
                       class="w-full px-4 py-3 text-center text-lg font-bold border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                       placeholder="000000">
                <input type="hidden" name="Method" value="sms">
            </div>
            <button type="button" class="w-full mt-3 text-sm text-blue-600 hover:text-blue-700 font-medium">
                Resend code
            </button>
        </div>

        <!-- Email tab -->
        <div id="tab-email" data-tab-content class="hidden">
            <p class="text-sm text-gray-600 text-center mb-2">We sent a code to</p>
            <p class="text-sm font-medium text-gray-900 text-center mb-4">j***@example.com</p>
            <div>
                <label for="email-code" class="block text-sm font-medium text-gray-700 mb-1">Verification Code</label>
                <input type="text" id="email-code" name="Code" maxlength="6"
                       class="w-full px-4 py-3 text-center text-lg font-bold border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                       placeholder="000000">
                <input type="hidden" name="Method" value="email">
            </div>
            <button type="button" class="w-full mt-3 text-sm text-blue-600 hover:text-blue-700 font-medium">
                Resend code
            </button>
        </div>

        <div class="flex items-center">
            <input type="checkbox" id="trustDevice" name="TrustDevice" class="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500">
            <label for="trustDevice" class="ml-2 text-sm text-gray-700">Trust this device for 30 days</label>
        </div>

        <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-3 px-4 rounded-lg transition-colors">
            Verify
        </button>

        <div class="text-center">
            <a href="#" class="text-sm text-gray-600 hover:text-gray-700">Use another verification method</a>
        </div>
    </form>

    <div class="mt-6 pt-6 border-t border-gray-200">
        <a href="/Account/Login" class="flex items-center justify-center text-sm text-gray-600 hover:text-gray-700">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            Back to login
        </a>
    </div>
</div>
