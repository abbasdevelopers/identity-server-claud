@inject IdentityServer.Services.MockDataService MockData
@{
    ViewData["Title"] = "Connected Accounts";
    var user = MockData.Users.FirstOrDefault();
}

<div class="max-w-7xl mx-auto space-y-6">
    <!-- Page Header -->
    <div>
        <h1 class="text-3xl font-bold text-gray-900">Connected Accounts</h1>
        <p class="text-gray-600 mt-1">Manage your linked accounts and OAuth applications</p>
    </div>

    <!-- Connected Accounts -->
    <div>
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-xl font-semibold text-gray-900">Connected Accounts</h2>
            <span class="text-sm text-gray-600">2 connected</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <!-- Google -->
            <div class="bg-white border-2 border-green-200 rounded-lg p-6">
                <div class="flex items-start justify-between mb-4">
                    <div class="w-12 h-12 bg-white rounded-lg shadow flex items-center justify-center">
                        <svg class="w-8 h-8" viewBox="0 0 24 24">
                            <path fill="#EA4335" d="M5.26620003,9.76452941 C6.19878754,6.93863203 8.85444915,4.90909091 12,4.90909091 C13.6909091,4.90909091 15.2181818,5.50909091 16.4181818,6.49090909 L19.9090909,3 C17.7818182,1.14545455 15.0545455,0 12,0 C7.27006974,0 3.1977497,2.69829785 1.23999023,6.65002441 L5.26620003,9.76452941 Z"/>
                            <path fill="#34A853" d="M16.0407269,18.0125889 C14.9509167,18.7163016 13.5660892,19.0909091 12,19.0909091 C8.86648613,19.0909091 6.21911939,17.076871 5.27698177,14.2678769 L1.23746264,17.3349879 C3.19279051,21.2936293 7.26500293,24 12,24 C14.9328362,24 17.7353462,22.9573905 19.834192,20.9995801 L16.0407269,18.0125889 Z"/>
                            <path fill="#4A90E2" d="M19.834192,20.9995801 C22.0291676,18.9520994 23.4545455,15.903663 23.4545455,12 C23.4545455,11.2909091 23.3454545,10.5272727 23.1818182,9.81818182 L12,9.81818182 L12,14.4545455 L18.4363636,14.4545455 C18.1187732,16.013626 17.2662994,17.2212117 16.0407269,18.0125889 L19.834192,20.9995801 Z"/>
                            <path fill="#FBBC05" d="M5.27698177,14.2678769 C5.03832634,13.556323 4.90909091,12.7937589 4.90909091,12 C4.90909091,11.2182781 5.03443647,10.4668121 5.26620003,9.76452941 L1.23999023,6.65002441 C0.43658717,8.26043162 0,10.0753848 0,12 C0,13.9195484 0.444780743,15.7301709 1.23746264,17.3349879 L5.27698177,14.2678769 Z"/>
                        </svg>
                    </div>
                    <span class="badge badge-success">Primary</span>
                </div>
                <h3 class="font-semibold text-gray-900 mb-1">Google</h3>
                <p class="text-sm text-gray-600 mb-1">@user?.Email</p>
                <p class="text-xs text-gray-500 mb-4">Connected on Oct 15, 2025</p>
                <button class="w-full px-4 py-2 text-sm border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50">
                    Disconnect
                </button>
            </div>

            <!-- GitHub -->
            <div class="bg-white border-2 border-gray-200 rounded-lg p-6">
                <div class="flex items-start justify-between mb-4">
                    <div class="w-12 h-12 bg-gray-900 rounded-lg flex items-center justify-center">
                        <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                        </svg>
                    </div>
                </div>
                <h3 class="font-semibold text-gray-900 mb-1">GitHub</h3>
                <p class="text-sm text-gray-600 mb-1">@(user?.Username)@("@github")</p>
                <p class="text-xs text-gray-500 mb-4">Connected on Oct 18, 2025</p>
                <button class="w-full px-4 py-2 text-sm border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50">
                    Disconnect
                </button>
            </div>
        </div>
    </div>

    <!-- Available Connections -->
    <div>
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-xl font-semibold text-gray-900">Available Connections</h2>
            <span class="text-sm text-gray-600">Connect more accounts</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <!-- Microsoft -->
            <div class="bg-white border-2 border-dashed border-gray-300 rounded-lg p-6 hover:border-blue-500 transition-colors">
                <div class="flex items-center justify-center w-12 h-12 bg-gray-100 rounded-lg mb-4">
                    <svg class="w-8 h-8 text-blue-600" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M11.4 24H0V12.6h11.4V24zM24 24H12.6V12.6H24V24zM11.4 11.4H0V0h11.4v11.4zm12.6 0H12.6V0H24v11.4z"/>
                    </svg>
                </div>
                <h3 class="font-semibold text-gray-900 mb-1">Microsoft</h3>
                <p class="text-sm text-gray-600 mb-4">Sign in with Microsoft account</p>
                <button class="w-full px-4 py-2 text-sm bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                    Connect
                </button>
            </div>

            <!-- Twitter -->
            <div class="bg-white border-2 border-dashed border-gray-300 rounded-lg p-6 hover:border-blue-500 transition-colors">
                <div class="flex items-center justify-center w-12 h-12 bg-gray-100 rounded-lg mb-4">
                    <svg class="w-8 h-8 text-blue-400" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
                    </svg>
                </div>
                <h3 class="font-semibold text-gray-900 mb-1">Twitter</h3>
                <p class="text-sm text-gray-600 mb-4">Sign in with Twitter account</p>
                <button class="w-full px-4 py-2 text-sm bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                    Connect
                </button>
            </div>

            <!-- LinkedIn -->
            <div class="bg-white border-2 border-dashed border-gray-300 rounded-lg p-6 hover:border-blue-500 transition-colors">
                <div class="flex items-center justify-center w-12 h-12 bg-gray-100 rounded-lg mb-4">
                    <svg class="w-8 h-8 text-blue-700" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                    </svg>
                </div>
                <h3 class="font-semibold text-gray-900 mb-1">LinkedIn</h3>
                <p class="text-sm text-gray-600 mb-4">Sign in with LinkedIn account</p>
                <button class="w-full px-4 py-2 text-sm bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                    Connect
                </button>
            </div>
        </div>
    </div>

    <!-- OAuth Applications -->
    <div>
        <div class="flex items-center justify-between mb-4">
            <div>
                <h2 class="text-xl font-semibold text-gray-900">Authorized Applications</h2>
                <p class="text-sm text-gray-600 mt-1">Applications that have access to your account</p>
            </div>
        </div>
        <div class="bg-white rounded-lg shadow divide-y divide-gray-200">
            @foreach(var client in MockData.Clients.Take(5))
            {
                <div class="p-6">
                    <div class="flex items-start justify-between">
                        <div class="flex items-start gap-4">
                            <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-purple-500 rounded-lg flex items-center justify-center text-white font-bold text-lg">
                                @client.ClientName.Substring(0, 1)
                            </div>
                            <div>
                                <h3 class="font-semibold text-gray-900 mb-1">@client.ClientName</h3>
                                <p class="text-sm text-gray-600 mb-2">@client.Description</p>
                                <div class="flex flex-wrap gap-2 mb-2">
                                    @foreach(var scope in client.AllowedScopes.Take(4))
                                    {
                                        <span class="badge badge-info">@scope</span>
                                    }
                                    @if(client.AllowedScopes.Count > 4)
                                    {
                                        <span class="badge badge-neutral">+@(client.AllowedScopes.Count - 4) more</span>
                                    }
                                </div>
                                <p class="text-xs text-gray-500">
                                    Last accessed: @(client.LastUsed?.ToString("MMM dd, yyyy") ?? "Never")
                                </p>
                            </div>
                        </div>
                        <button class="px-4 py-2 text-sm border border-red-300 text-red-600 rounded-lg hover:bg-red-50 font-medium" data-confirm="Revoke access for @client.ClientName?">
                            Revoke Access
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Info Box -->
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
        <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-blue-600 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <div>
                <p class="text-sm font-medium text-blue-900">About Connected Accounts</p>
                <p class="text-sm text-blue-800 mt-1">Connecting your accounts allows you to sign in using those providers and enables enhanced features. You can disconnect at any time.</p>
            </div>
        </div>
    </div>
</div>
