                                </svg>
                            </div>
                            <p class="text-sm font-medium text-gray-900 text-center">Dark</p>
                        </div>
                    </label>

                    <label class="cursor-pointer">
                        <input type="radio" name="theme" value="auto" class="sr-only peer">
                        <div class="border-2 border-gray-200 rounded-lg p-4 peer-checked:border-blue-600 peer-checked:bg-blue-50 hover:border-gray-300 transition-colors">
                            <div class="aspect-video bg-gradient-to-r from-white to-gray-900 rounded border border-gray-300 mb-3 flex items-center justify-center">
